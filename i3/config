set $mod Mod4
focus_follows_mouse no

font pango:Iosevka Nerd Font 12

# Autostart
exec --no-startup-id dex --autostart --environment i3
# Network Manager
exec --no-startup-id nm-applet
# Compositor
exec --no-startup-id picom
# Dunst
exec --no-startup-id dunst
# Flameshot
exec --no-startup-id flameshot
# Asus stuff
exec --no-startup-id "sudo systemctl start asusd"

# Keyboard layout
exec_always --no-startup-id "setxkbmap -layout us,ru -variant colemak_dh_ortho, -option 'grp:win_space_toggle'"

# BG
exec --no-startup-id ~/.fehbg

# Modifiers
floating_modifier $mod
tiling_drag modifier titlebar

# Bindings
bindsym $mod+Return exec ghostty
bindsym $mod+d exec --no-startup-id "rofi -modi drun,run -show drun"
bindsym $mod+q kill
# Focus
bindsym $mod+m focus left
bindsym $mod+n focus down
bindsym $mod+e focus up
bindsym $mod+i focus right
# Move focused window
bindsym $mod+Shift+m move left
bindsym $mod+Shift+n move down
bindsym $mod+Shift+e move up
bindsym $mod+Shift+i move right
# Change split direction
bindsym $mod+h split h
bindsym $mod+v split v
# Enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle
# change container layout
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+t layout toggle split
# Toggle tiling / floating
bindsym $mod+z floating toggle
# Change focus between tiling / floating windows
bindsym $mod+k focus mode_toggle
# Focus the parent container
bindsym $mod+a focus parent

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"
# Switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10
# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Reload the configuration file
bindsym $mod+Shift+c reload
# Restart i3 inplace
bindsym $mod+Shift+r restart
# Exit i3
bindsym $mod+Shift+x exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# Resize window
bindsym $mod+r mode "resize"
mode "resize" {
    bindsym shift+m resize shrink width 10 px or 10 ppt
    bindsym shift+n resize grow height 10 px or 10 ppt
    bindsym shift+e resize shrink height 10 px or 10 ppt
    bindsym shift+i resize grow width 10 px or 10 ppt
    
    # Back to normal
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

# Gaps
gaps inner 5
gaps outer 5

# Bar
bar {
    status_command i3status-rs
    position bottom
    colors {
        separator #666666
        background #222222
        statusline #dddddd
        focused_workspace #0088CC #0088CC #ffffff
        active_workspace #333333 #333333 #ffffff
        inactive_workspace #333333 #333333 #888888
        urgent_workspace #2f343a #900000 #ffffff
    }
}

# Special keys
# Sound control
bindsym XF86AudioRaiseVolume exec --no-startup-id pamixer -i 5
bindsym XF86AudioLowerVolume exec --no-startup-id pamixer -d 5
bindsym XF86AudioMute exec --no-startup-id pamixer -t
# Brightness control
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-
