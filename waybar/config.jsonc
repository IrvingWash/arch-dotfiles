// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "bottom",
    "height": 30,
    "spacing": 1,
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/submap"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "hyprland/language",
        "pulseaudio",
        "keyboard-state",
        "temperature",
        "cpu",
        "memory",
        "disk",
        "battery",
        "clock"
    ],

    "hyprland/workspaces": {
        "persistent-workspaces": {
            "*": 10
        },
        "format": "{icon}",
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "6": "六",
            "7": "七",
            "8": "八",
            "9": "九",
            "10": "十",
        }
    },
    "hyprland/language": {
        "format": "{}",
        "format-ru": "RU",
        "format-en": "US"
    },
    "pulsaudio": {
        format: "{volume}% "
    },
    "memory": {
        "format": "{percentage}% ",
    },
    "sway/language": {
        "format": "{short} {variant}",
    },
    "keyboard-state": {
        "format": "󰌎",
        "capslock": true
    },
    "cpu": {
        "format": "{usage}% ",
    },
    "disk": {
        "format": "{free}"
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": ["", "", "", "", ""]
    },
    "clock": {
        "format": "{:%a, %d, %b %H:%M}"
    }
}
